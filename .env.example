# 取消下面两行的注释，并替换为独立的强随机值。
# ADMIN_PASSWORD=replace-with-a-long-random-password
# SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
BIND_ADDRESS=127.0.0.1
WEB_PORT=8000
SOCKS_PORT=1080
HTTP_PROXY_PORT=8080
TZ=UTC
COOKIE_SECURE=false
XRAY_VPN_OUTBOUND_TAGS=vpn-out
APP_VERSION=0.1.0
IMAGE_NAME=ghcr.io/fortressme/proxy2openconnect
IMAGE_TAG=latest
